# Copy this file to electron-builder.env (gitignored) and fill in a real
# token. electron-builder's CLI automatically loads electron-builder.env
# from the project root, so `npm run release:win` / `release:mac` /
# `release:linux` will pick this up without exporting it in your shell.
#
# Create at: https://github.com/settings/tokens
# Scope needed: "repo" (classic) or Contents: Read and write (fine-grained,
# scoped to this repository).
GH_TOKEN=
