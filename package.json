{
  "name": "quota-bar",
  "version": "0.4.0",
  "description": "Cross-platform tray app for monitoring AI quota usage.",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"vite --host 127.0.0.1\" \"wait-on tcp:5173 dist/main/main/main.js && node scripts/dev-electron.js\"",
    "build:main": "tsc -p tsconfig.json",
    "compile": "tsc -p tsconfig.json && vite build",
    "build": "npm run compile && electron-builder --dir",
    "package": "npm run package:mac",
    "package:mac": "npm run compile && electron-builder --mac",
    "package:win": "npm run compile && electron-builder --win",
    "package:linux": "npm run compile && electron-builder --linux",
    "release:mac": "npm run compile && electron-builder --mac --publish always",
    "release:win": "npm run compile && electron-builder --win --publish always",
    "release:linux": "npm run compile && electron-builder --linux --publish always",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.config.ts tests/unit",
    "test:integration": "vitest run --config vitest.config.ts tests/integration",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "keywords": [
    "macos",
    "windows",
    "linux",
    "menu-bar",
    "ai",
    "usage"
  ],
  "author": "apg0001 <apg0001@dgu.ac.kr>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/apg0001/AI_Agent_Usage_Widget_for_MAC.git"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.apg0001.aiusagewidget",
    "productName": "GigaCharge",
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "apg0001",
      "repo": "AI_Agent_Usage_Widget_for_MAC",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "category": "Utility",
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
